    "public_github_no_pii": true,
    "anonymous_diagnosis_independent_of_signup": true,
    "birth_data_required": false,
    "diagnosis_answers_transferred_to_crm": false,
    "service_work_in_background": false
  },
  "official_sources": [
    {
      "kind": "statutory_guidance",
      "agency": "Consumer Affairs Agency",
      "url": "https://www.no-trouble.caa.go.jp/what/mailorder/",
      "principle": "prior consent for commercial mail of mail-order sellers, consent record retention generally 3 yrs from last commercial email (subject to applicability and exceptions)"
    },
    {
      "kind": "interpretation",
      "agency": "Consumer Affairs Agency",
      "url": "https://www.no-trouble.caa.go.jp/pdf/20230623la03_04.pdf",
      "principle": "regulatory record rules for consent and refusal"
    },
    {
      "kind": "guideline",
      "agency": "Personal Information Protection Commission",
      "url": "https://www.ppc.go.jp/all_faq_index/faq1-q4-17/",
      "principle": "purpose notice generally required for directly collected email on web form"
    },
    {
      "kind": "guideline",
      "agency": "Personal Information Protection Commission",
      "url": "https://www.ppc.go.jp/all_faq_index/faq1-q5-2/",
      "principle": "no fixed generic retention term; remove when no longer needed, subject to other requirements"
    },
    {
      "kind": "guideline",
      "agency": "Personal Information Protection Commission",
      "url": "https://www.ppc.go.jp/personalinfo/legal/guidelines_tsusoku/",
      "principle": "data protection, purpose, safety, data subject rights"
    },
    {
      "kind": "guideline",
      "agency": "Personal Information Protection Commission",
      "url": "https://www.ppc.go.jp/all_faq_index/faq1-q7-53/",
      "principle": "cloud processor status depends on contract and actual data access"
    }
  ],
  "cta": {
    "id": "CTA-L01",
    "screen": "F08",
    "label": "もちもち占術の読み物・更新案内を受け取る",
    "condition_to_show": "verified_operator && live_privacy_terms_contact && approved_provider && optin_legal_review && M11_M12_G1_release_decision",
    "default_visibility": "hidden",
    "mandatory": false,
    "receives_diagnosis_payload": false,
    "destination_screen": "L00"
  },
  "forms": [
    {
      "id": "L00",
      "name": "optional_signup",
      "fields": [
        "email",
        "optional_self_selected_topics",
        "unchecked_marketing_opt_in"
      ],
      "privacy_link_required": true,
      "contact_link_required": true,
      "default_consent": false,
      "needs_purpose_notice_before_data_entry": true
    },
    {
      "id": "L01",
      "name": "confirmation_pending",
      "privacy": "generic_response_no_email_enumeration",
      "commercial_send_allowed": false
    },
    {
      "id": "L02",
      "name": "verification",
      "single_use": true,
      "token_expiry_hours_proposed": 48,
      "replay_denied": true
    },
    {
      "id": "L03",
      "name": "active_subscriber",
      "requires_email_verified": true,
      "requires_marketing_consent": true
    },
    {
      "id": "L04",
      "name": "unsubscribe_preferences",
      "no_login_required_for_one_click_unsubscribe": true,
      "token_integrity_required": true,
      "immediate_suppression": true
    }
  ],
  "status_enum": [
    "pending",
    "active",
    "unsubscribed",
    "suppressed",
    "bounced",
    "complaint",
    "deleted"
  ],
  "transitions": [
    {
      "from": "new",
      "to": "pending",
      "event": "registration_request_with_unchecked_by_default_marketing_optin_selected",
      "allows_commercial_mail": false
    },
    {
      "from": "pending",
      "to": "active",
      "event": "valid_single_use_email_verification_and_consent_confirmed",
      "allows_commercial_mail": true
    },
    {
      "from": "pending",
      "to": "deleted",
      "event": "seven_day_nonverification_purge",
      "allows_commercial_mail": false
    },
    {
      "from": "active",
      "to": "unsubscribed",
      "event": "unsubscribe_requested",
      "allows_commercial_mail": false
    },
    {
      "from": "active",
      "to": "bounced",
      "event": "hard_bounce",
      "allows_commercial_mail": false
    },
    {
      "from": "active",
      "to": "complaint",
      "event": "spam_complaint",
      "allows_commercial_mail": false
    },
    {
      "from": "unsubscribed",
      "to": "pending",
      "event": "new_explicit_consent_plus_new_verification",
      "allows_commercial_mail": false
    },
    {
      "from": "active",
      "to": "deleted",
      "event": "verified_deletion_request_with_legal_record_separation",
      "allows_commercial_mail": false
    },
    {
      "from": "unsubscribed",
      "to": "deleted",
      "event": "verified_deletion_request_with_legal_record_separation",
      "allows_commercial_mail": false
    }
  ],
  "invariants": [
    "Only active + verified_email + latest_marketing_opt_in + !suppressed + provider_approved receives marketing email",
    "Evaluate send_allowed both at queue time and immediately before provider send",
    "No marketing email to pending, bounced, complaint, unsubscribed, deleted",
    "Marketing confirmation email has verification instructions only and no marketing",
    "Unsubscribe does not require an account or purchase",
    "Unsubscribe never requires resubscribe and is effective before deletion processing",
    "Old consent records or prior diagnostic registrations cannot authorize new marketing",
    "Suppression survives backup restoration",
    "Q1-Q5 choices and answers do not enter CRM, outbound messages or analytics",
    "Do not restore an unsubscribed lead to active without fresh explicit consent and email verification",
    "No actual PIIs or tokens in public GitHub"
  ],
