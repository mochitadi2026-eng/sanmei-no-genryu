  "global_rules": {
    "has_real_public_url": false,
    "allows_public_release": false,
    "requires_email": false,
    "requires_birth_info": false,
    "requires_purchase": false,
    "no_user_response_to_analytics": true,
    "no_claim_of_psychometric_or_predictive_validity": true,
    "types_not_guaranteed": true,
    "do_not_collect_personal_data_in_public_git": true
  },
  "lp": {
    "screen": "F00",
    "title": "もちもち占術｜5問で今の自分を振り返る無料診断",
    "h1": "今の自分を、ちょっと読み直してみる。",
    "lead": "5つの質問に答えると、今の気持ちに寄り添う小さな物語と、自分に返す一つの問いが見つかります。",
    "primary_cta_id": "CTA01",
    "secondary_cta_id": "CTA02",
    "conditions": [
      "登録不要・生年月日不要・決めない選択もOK",
      "性格や能力を測る検査ではなく、自己理解のための創作コンテンツ"
    ],
    "sections": [
      {
        "section": "hero",
        "order": 1,
        "required": true
      },
      {
        "section": "benefits",
        "order": 2,
        "required": true,
        "benefits": [
          "今のテーマを眺める",
          "小さな物語を読む",
          "自分に一問を返す"
        ]
      },
      {
        "section": "how_it_works",
        "order": 3,
        "required": true
      },
      {
        "section": "limitations_and_privacy",
        "order": 4,
        "required": true,
        "privacy_claim_requires_network_audit": true
      },
      {
        "section": "faq",
        "order": 5,
        "required": true
      },
      {
        "section": "operator_legal_footer",
        "order": 6,
        "required": true,
        "publish_only_with_verified_live_links": true
      }
    ],
    "faq_questions": [
      "お金はかかる？",
      "生年月日は必要？",
      "迷ったら？",
      "心理テスト？",
      "回答は保存される？",
      "有料鑑定はある？"
    ],
    "unanswered_faq": "回答は保存される？",
    "copy_state": "draft_publication_requires_G1"
  },
  "screens": [
    {
      "id": "F00",
      "role": "landing",
      "primary_cta": "CTA01",
      "requires": "operator_links_reviewed"
    },
    {
      "id": "F01",
      "role": "prestart_information",
      "primary_cta": "CTA03",
      "requires": "actual_data_handling_explained_and_acknowledged"
    },
    {
      "id": "F02",
      "role": "question",
      "question_id": "Q1",
      "requires": "scene_v01_approved",
      "allow_choice_x": true
    },
    {
      "id": "F03",
      "role": "question",
      "question_id": "Q2",
      "requires": "same_scene_v01_approved",
      "allow_choice_x": true
    },
    {
      "id": "F04",
      "role": "question",
      "question_id": "Q3",
      "requires": "question_bank_m07",
      "allow_choice_x": true
    },
    {
      "id": "F05",
      "role": "question",
      "question_id": "Q4",
      "requires": "question_bank_m07",
      "allow_choice_x": true
    },
    {
      "id": "F06",
      "role": "question",
      "question_id": "Q5",
      "requires": "question_bank_m07",
      "allow_choice_x": true
    },
    {
      "id": "F07",
      "role": "result",
      "requires": "M08_M09_version_match",
      "allow_type_pending": true,
      "disable_birth_character": true
