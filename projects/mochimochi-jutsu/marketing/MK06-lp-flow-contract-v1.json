    {
      "id": "F08",
      "role": "optional_next_step",
      "requires": "real_public_content_link_or_hide",
      "no_paid_cta": true
    }
  ],
  "cta": [
    {
      "id": "CTA01",
      "label": "5問の無料診断をはじめる",
      "screen": "F00",
      "action": "go_F01",
      "active_in_public": false
    },
    {
      "id": "CTA02",
      "label": "どんな診断？",
      "screen": "F00",
      "action": "scroll_to_explanation",
      "active_in_public": false
    },
    {
      "id": "CTA03",
      "label": "説明を確認してはじめる",
      "screen": "F01",
      "action": "go_F02_and_emit_diagnosis_start",
      "active_in_public": false
    },
    {
      "id": "CTA04",
      "label": "次へ",
      "screen": "F02-F06",
      "action": "next_if_valid_choice",
      "active_in_public": false
    },
    {
      "id": "CTA05",
      "label": "決めない",
      "screen": "F02-F06",
      "action": "record_answer_id_x_not_missing",
      "active_in_public": false
    },
    {
      "id": "CTA06",
      "label": "戻る",
      "screen": "F01-F07",
      "action": "navigate_back_keeping_local_answers_until_end",
      "active_in_public": false
    },
    {
      "id": "CTA07",
      "label": "結果を見る",
      "screen": "F06",
      "action": "validate_M08_then_show_F07",
      "active_in_public": false
    },
    {
      "id": "CTA08",
      "label": "もう一度選ぶ",
      "screen": "F07-F08",
      "action": "discard_answers_and_restart_F01",
      "active_in_public": false
    },
    {
      "id": "CTA09",
      "label": "占術について知る",
      "screen": "F08",
      "action": "open_real_published_explanatory_resource_only",
      "display_rule": "hide_until_target_exists",
      "active_in_public": false
    },
    {
      "id": "CTA10",
      "label": "利用規約／プライバシー／問い合わせ",
      "screen": "F00-F01-F08",
      "action": "open_verified_operator_documents",
      "display_rule": "G1_requires_live_links",
      "active_in_public": false
    }
  ],
